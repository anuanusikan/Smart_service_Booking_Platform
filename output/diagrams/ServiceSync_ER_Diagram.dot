    </TABLE>>];
 USER -> JOB [label="posts as customer", weight=5];
 JOB -> QUOTE [label="receives", weight=3];
 JOB -> BOOKING [label="has requests and bookings", weight=4];
 BOOKING -> MESSAGE [label="contains", weight=4];
 BOOKING -> REVIEW [label="receives at most one", arrowhead=teeodot, weight=5];
 JOB -> REVIEW [label="concerns", constraint=false];
 USER -> QUOTE [label="provider submits / customer receives", color="#b5c6d2", constraint=false];
 USER -> BOOKING [label="customer / provider participates", color="#b5c6d2", constraint=false];
 USER -> REVIEW [label="customer writes / provider receives", color="#b5c6d2", constraint=false];
 USER -> MESSAGE [label="sender writes", color="#b5c6d2", constraint=false];
 USER -> NOTIFICATION [label="recipient receives", weight=1];
 USER -> NOTIFICATION [label="sender triggers (optional)", arrowtail=teeodot, constraint=false, color="#b5c6d2"];
 legend [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Reading the diagram</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK primary key  |  UK unique index  |  REF application reference</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Crow foot with circle = zero or many  |  Bar with circle = zero or one</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Every collection includes createdAt and updatedAt timestamps.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">User roles share one collection. Role-specific links are combined for readability.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">hiddenFor contains user references for per-user visibility; it is not a deletion.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">References are checked in application code, not database-enforced foreign keys.</FONT></TD></TR></TABLE>>];
 {rank=same; USER; legend;}
 USER -> legend [style=invis];
}