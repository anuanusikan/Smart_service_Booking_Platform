digraph ServiceSyncER {
 graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.65", ranksep="1.05", splines=polyline, outputorder=edgesfirst,
 label="ServiceSync  |  Entity relationship diagram
MongoDB document model and Mongoose references", labelloc=t, labeljust=l, fontname="Arial", fontsize=25, fontcolor="#122e44"];
 node [shape=plain, fontname="Arial"];
 edge [fontname="Arial", fontsize=10, color="#6d879a", fontcolor="#415e73", penwidth=1.3, arrowsize=.7, dir=both, arrowtail=teetee, arrowhead=crowodot];
